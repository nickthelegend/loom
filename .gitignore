desktop/dist/
# The daemon staged for packaging: a copy of dist/ plus ~78MB of production
# node_modules, rebuilt by `npm run stage` on every `npm run dist`. Output, not
# source. (The icons next to it under desktop/build/ ARE source — hence the
# narrow path rather than desktop/build/.)
desktop/build/daemon/

# Reference clones read while designing (mem0, AntiGravity-AutoAccept, …). They
# are other people's repos with their own licences and histories — 54MB of mem0
# alone. Cloned on demand; never ours to commit.
references/

# Scratch Next.js app used as a throwaway target project when driving the
# daemon by hand (`loom init` against something real). Generated, not source.
test-loom/

# HyperFrames video projects: keep the plan + frames, not the heavy build output
videos/*/node_modules/
videos/*/capture/
videos/*/renders/
videos/*/snapshots/
videos/*/assets/voice/
videos/*/footage/*.mp4
videos/*/footage/*.mov
videos/*/footage/*.webm
