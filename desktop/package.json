{
  "name": "loom-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Loom desktop \u2014 an Electron shell around the loom daemon's web app. See BUILD.md for why the build config looks like this.",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickthelegend/loom.git"
  },
  "scripts": {
    "prestart": "node scripts/dev-brand.mjs",
    "start": "electron .",
    "stage": "node ../scripts/stage-daemon.mjs",
    "dist": "npm run stage && electron-builder",
    "dist:dir": "npm run stage && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.loom.desktop",
    "productName": "Loom Desktop",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "loom-app.js",
      "updater.js",
      "updater-mac.js",
      "preload.cjs",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/daemon",
        "to": "daemon",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nickthelegend",
        "repo": "loom"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "CFBundleDisplayName": "Loom"
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "Loom-Desktop-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "nickthelegend"
    },
    "afterPack": "build/adhoc-sign.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  }
}
