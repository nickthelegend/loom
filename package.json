{
  "name": "@loompad/cli",
  "version": "1.3.0",
  "description": "Loom — local-first control plane for coding agents: one CLI, shared memory, baton handoffs and routes across Claude Code, OpenCode, and friends.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Nivesh Gajengi <niveshgajengi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickthelegend/loom.git"
  },
  "homepage": "https://github.com/nickthelegend/loom#readme",
  "bugs": "https://github.com/nickthelegend/loom/issues",
  "keywords": [
    "ai-agents",
    "claude-code",
    "opencode",
    "orchestration",
    "cli",
    "tui",
    "llm",
    "routing",
    "tailscale"
  ],
  "files": [
    "dist",
    "docs/**/*.md",
    "docs/refactoring/brain-benchmark*.json",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "loom": "./dist/cli/index.js",
    "loompad": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./sdk": "./dist/sdk.js"
  },
  "scripts": {
    "build": "npm run build:web && tsc && node scripts/prune-dist.mjs",
    "prepare": "npm run build",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "test:all-parallel": "vitest run",
    "verify:adapters": "node scripts/verify-adapters.mjs",
    "build:web": "node scripts/build-web.mjs",
    "predev": "npm run build:web"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "ink": "^7.1.0",
    "koffi": "3.3.3",
    "picocolors": "^1.1.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.7",
    "ws": "^8.21.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.15"
  }
}
